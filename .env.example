# Copy to .env for local development (never commit the real .env).
# In GitHub Actions these are set as repository Secrets/Variables instead —
# see the "Deploying" section of README.md.

# --- LLM (any OpenAI-Chat-Completions-compatible endpoint) ---
PAP_LLM_API_KEY=
PAP_LLM_BASE_URL=https://api.openai.com/v1
PAP_LLM_MODEL=gpt-4o-mini

# --- TTS ---
# provider = edge (free, default) | openai (paid fallback)
PAP_TTS_PROVIDER=edge
PAP_TTS_VOICE=fa-IR-DilaraNeural
# Only needed if PAP_TTS_PROVIDER=openai
PAP_TTS_OPENAI_API_KEY=
PAP_TTS_OPENAI_BASE_URL=https://api.openai.com/v1
PAP_TTS_OPENAI_MODEL=gpt-4o-mini-tts

# --- Telegram ingestion (reading channels — needs a *user* session) ---
# Generate a session string once locally with Telethon's StringSession
# helper; never store your personal account password here.
PAP_TG_INGEST_API_ID=
PAP_TG_INGEST_API_HASH=
PAP_TG_INGEST_SESSION_STRING=

# --- Telegram publishing (posting the digest — a bot token is enough) ---
PAP_TG_PUBLISH_BOT_TOKEN=
PAP_TG_PUBLISH_CHAT_ID=
